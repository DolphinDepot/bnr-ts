{
  "name": "@dolphindepot/bnr",
  "version": "0.1.1",
  "description": "Encode and decode Nintendo GameCube BNR1/BNR2 (opening.bnr) files",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DolphinDepot/bnr-ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "devDependencies": {
    "prettier": "^3",
    "tsdown": "^0",
    "typescript": "^6",
    "vitest": "^4"
  }
}
